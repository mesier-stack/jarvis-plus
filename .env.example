# Never paste your key into chat or commit it to source control.
# Set these as Windows environment variables instead:
# setx OPENAI_API_KEY "your-key"
# setx OPENAI_MODEL "gpt-5.6"
# setx JARVIS_VOICE "cedar"
# Set JARVIS_CLOUD_VOICE to 0 if you only want the offline Windows voice.

# Google AI Studio alternative (you only need one provider):
# setx GEMINI_API_KEY "your-google-ai-studio-key"
# setx GEMINI_MODEL "gemini-3.6-flash"
# setx GEMINI_TTS_MODEL "gemini-3.1-flash-tts-preview"
# setx GEMINI_VOICE "Gacrux"

# Optional: fastest, most natural voice. Configure it from VOICE SETUP in JARVIS+.
# setx ELEVENLABS_API_KEY "your-elevenlabs-key"
# setx ELEVENLABS_VOICE_ID "JBFqnCBsd6RMkjVDRZzb"
# setx ELEVENLABS_MODEL "eleven_flash_v2_5"
