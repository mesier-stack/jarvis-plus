# ULTRON environment example
# Never paste API keys into chat or commit them to source control.

# NVIDIA NIM / Nemotron
# setx NVIDIA_API_KEY "your-nvidia-key"
# setx NVIDIA_MODEL "nvidia/nemotron-3-ultra-550b-a55b"

# OpenAI
# setx OPENAI_API_KEY "your-openai-key"
# setx OPENAI_MODEL "gpt-5.6"
# setx ULTRON_VOICE "cedar"

# Google Gemini
# setx GEMINI_API_KEY "your-google-ai-studio-key"
# setx GEMINI_MODEL "gemini-3.6-flash"
# setx GEMINI_TTS_MODEL "gemini-3.1-flash-tts-preview"
# setx GEMINI_VOICE "Gacrux"

# ElevenLabs
# setx ELEVENLABS_API_KEY "your-elevenlabs-key"
# setx ELEVENLABS_VOICE_ID "your-voice-id"
# setx ELEVENLABS_MODEL "eleven_flash_v2_5"

# Set ULTRON_CLOUD_VOICE to 0 to force the offline Windows voice.
